# OpenWeatherMap API Key.
# La usan tanto producer_openweathermap.py como el endpoint proxy
# GET /api/clima/punto de la API. NUNCA debe volver al frontend:
# el dashboard consulta el proxy, no a OpenWeatherMap directamente.
OPENWEATHERMAP_API_KEY=tu_api_key_aqui

# Ruta dentro del contenedor donde se montará la Service Account de Google Earth Engine
GEE_CREDENTIALS_PATH=/app/ensostreamingpipeline-7f414895f6f4.json

# Conexión al clúster de Kafka desde el contenedor de los productores
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Zona horaria del contenedor (Ecuador / Guayaquil: UTC-5)
TZ=America/Guayaquil

# Credenciales de Copernicus Marine Service (producer_copernicus.py).
# Si están vacías el productor no arranca el loop, en vez de fallar cada ciclo.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# --- Cadencias de ingesta (segundos) ---
# Cada fuente se consulta a su ritmo real. Estos son los valores por defecto;
# descomentá y ajustá si querés otra cadencia sin tocar el código.
# INTERVALO_MAREAS=900            # INOCAR: interpolación al instante actual
# INTERVALO_EMBALSE=3600          # CELEC: boletines de prensa
# INTERVALO_ALERTAS=900           # SNGR: alertas
# INTERVALO_CLIMA=3600            # NASA POWER, Open-Meteo, OWM, INAMHI, GEE
# INTERVALO_INDICES=3600          # NOAA, ENSO indexes, Copernicus, boyas
# INTERVALO_PRECIPITACION=900     # INAMHI estaciones automáticas (Guayas)
# INTERVALO_PRONOSTICO=1800       # Open-Meteo pronóstico cuantitativo
# INTERVALO_MAREA_OBS=900         # IOC mareógrafo real (gyer)
# INTERVALO_CAUDAL=3600           # GEOGLOWS v2 (ECMWF)
# INTERVALO_SST_SEMANAL=43200     # NOAA CPC wksst9120.for
# INTERVALO_NIVEL_RIO=43200       # INAMHI nivel de río (contexto, no alimenta el índice)


# --- Ventana de consulta para las fuentes con rango de fechas (días) ---
# VENTANA_DIAS_CLIMA=15

# --- HDFS ---
# Raíz de datos, compartida por `producers` y `api` (los dos leen este mismo
# archivo). Va SIN esquema: ambos hablan WebHDFS, que recibe rutas, no URIs.
# El `hdfs://namenode:8020/...` que ves en compose.yml es solo del
# spark-submitter, que sí necesita el esquema y tiene su propio `environment`.
# Si la cambiás acá, cambia a la vez dónde escriben los productores y dónde
# lee la API — que es exactamente el punto de que sea una sola variable.
# HDFS_BASE_PATH=/enso_data

# --- Auditoría de logs (GET /api/logs) ---
# Cada productor sube su log a HDFS. `run_loop` vuelca el buffer al terminar
# cada ciclo, así que este intervalo solo actúa como red de seguridad para los
# procesos que no usan run_loop (run_producers.py, que corre indefinidamente).
# INTERVALO_FLUSH_LOGS_S=60
